[node name="RichTextLabel" type="RichTextLabel" parent="GuideDialog" unique_id=261940518]
offset_right = 40.0
offset_bottom = 40.0
theme_override_fonts/bold_font = SubResource("SystemFont_guide_bold")
theme_override_fonts/italics_font = SubResource("SystemFont_guide_italic")
bbcode_enabled = true
text = "[center][font_size=20][b]PhotoLab Guide[/b][/font_size][/center]

[b]Media Library[/b]
Click a photo on the left to open it.

[b]Filters[/b]
Filters change the whole look of the photo.

[b]Sliders[/b]
[ul][color=#ffd27f]Exposure[/color] – brighter or darker
[color=#ffd27f]Contrast[/color] – stronger or flatter colours
[color=#ffd27f]Noise[/color] – old film grain[/ul]

[i]Hint: Play around to reveal the secret behind the image![/i]"

